+# Copy this file to .env and fill in your own keys. Never commit .env.
+# Node loads it automatically if you start the server with:
+#   node --env-file=.env server.js
+
+# Google Cloud Text-to-Speech — used by Autopilot to generate scene voiceover.
+# Free tier: 4M chars/month (Standard), 1M chars/month (WaveNet/Neural2/Chirp3).
+# Get a key: https://console.cloud.google.com/apis/credentials
+# (enable the "Cloud Text-to-Speech API" on your project first)
+GOOGLE_TTS_API_KEY=
+
+# Optional — defaults to en-US-Neural2-D if not set.
+# Browse voices: https://cloud.google.com/text-to-speech/docs/voices
+GOOGLE_TTS_VOICE=en-US-Neural2-D
+
+# Pexels — used by Autopilot to fetch stock b-roll for scenes with no
+# footage of your own attached. Free, no card required.
+# Get a key: https://www.pexels.com/api/
+PEXELS_API_KEY=
+
+# Optional — server port, defaults to 3000.
+PORT=3000
