# Copy this file to .env and fill in your own values. Never commit .env.
# Node loads it automatically if you start the server with:
#   node --env-file=.env server.js

# Voiceover — runs on Microsoft Edge's TTS service via the @travisvn/edge-tts
# package. No API key, no billing account, nothing to sign up for.
# Optional — defaults to en-US-EmmaMultilingualNeural if not set.
# See other voice options by calling listVoices() from that package, or
# just try a different name from https://github.com/travisvn/edge-tts
EDGE_TTS_VOICE=en-US-EmmaMultilingualNeural

# Pexels — used by Autopilot to fetch stock b-roll for scenes with no
# footage of your own attached. Free, no card required.
# Get a key: https://www.pexels.com/api/
PEXELS_API_KEY=

# Optional — server port, defaults to 3000.
PORT=3000
